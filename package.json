{
  "name": "@citisen/dsh-font",
  "version": "0.2.4",
  "description": "DeepSeek Harness plugin: customize the Web GUI fonts (interface family, code family, and three font-size axes) from Settings",
  "type": "module",
  "license": "MIT",
  "author": "citisen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citisen/dsh-font.git"
  },
  "homepage": "https://github.com/citisen/dsh-font#readme",
  "bugs": {
    "url": "https://github.com/citisen/dsh-font/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "src",
    "scripts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "watch": "node scripts/build-client.mjs --watch",
    "verify": "node scripts/verify-host.mjs && node scripts/verify-client.mjs",
    "check": "node scripts/build-client.mjs --check && npm run verify",
    "check:all": "npm run check && node scripts/verify-profile.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "font",
    "fonts",
    "font-family",
    "font-size",
    "theme",
    "web-ui",
    "web-gui"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@citisen/litearea": "^0.2.2"
  }
}
